use crate::ast::*;
use crate::types::Monotype;
use crate::types::TypeContext;
use std::str::FromStr;

grammar;

match {
    r"\s+" => { }, // Skip whitespace (disables default behavior if custom ignore patterns are present)
    r"#[^\n\r]*[\n\r]*" => { }, // Skip single-line // comments
    _, // Catch-all: identity-map any terminal literals used in the grammar
}

// Productions that build an `Expr`/`Stmt` bind `@L`/`@R` (the production's
// byte-offset start/end) into `start`/`end`; `Program::parse` converts these
// into line/column spans afterwards.
pub Prog: Box<Program> = <ss:SemiCol<Stmt>> => Box::new(Program { stmts : ss, ctx : TypeContext::new(), source_name : String::new() });

// ----------------------------------------------------------------------------
// Types
// ----------------------------------------------------------------------------

Type: Box<Type> = {
    TypeBase                        => <>,
    <t1:TypeBase> "=>" <t2:Type>    => Box::new(Type { t: Monotype::func(vec![t1.t, t2.t]) }),
};

TypeBase: Box<Type> = {
    BuiltinType                 => <>,
    AppType                     => <>,
    TypeVar                     => Box::new(Type { t: Monotype::var(<>) }),
    "list" <t:TypeBase>         => Box::new(Type { t: Monotype::list(t.t) }),
    "(" <t:Type> ")"            => t,
};

// Enum applications: `ConsName(typevar1, ..., typevarn)`, e.g. `Option(int)`
// or `Result(int, str)`. Arguments (AppArg) sit one level below AppType so the
// bracket-delimited application stays LALR(1)-parseable; a bare `ConsName`
// argument is a nullary constructor, and nested applications are allowed.
AppType: Box<Type> = {
    <n:ConsName>                                                    => Box::new(Type { t: Monotype::enum_type(n) }),
    <n:ConsName> "(" <ts:CommaOne<AppArg>> ")"                      => Box::new(Type { t: Monotype::enum_app(n, ts.into_iter().map(|b| b.t).collect()) }),
}

AppArg: Box<Type> = {
    BuiltinType                 => <>,
    ConsName                    => Box::new(Type { t: Monotype::enum_type(<>) }),
    <n:ConsName> "(" <ts:CommaOne<AppArg>> ")"  => Box::new(Type { t: Monotype::enum_app(n, ts.into_iter().map(|b| b.t).collect()) }),
    TypeVar                     => Box::new(Type { t: Monotype::var(<>) }),
    "list" <t:AppArg>           => Box::new(Type { t: Monotype::list(t.t) }),
    "(" <t:Type> ")"            => t,
};

BuiltinType: Box<Type> = {
    "int"       => Box::new(Type { t: Monotype::int() }),
    "bool"      => Box::new(Type { t: Monotype::bool() }),
    "float"     => Box::new(Type { t: Monotype::float() }),
    "str"       => Box::new(Type { t: Monotype::string() }),
    "char"      => Box::new(Type { t: Monotype::char() }),
    "()"        => Box::new(Type { t: Monotype::unit() }),
};

TypeDecl: Stmt = {
    <start:@L> "type" <h:TypeHeader> <t:Type> <end:@R>              => Stmt::at(Pos::bytes(start as u32, end as u32), SNode::TypeDecl(h, Box::new(TypeDec::Alias(t)))),
    <start:@L> "enum "<h:TypeHeader> <vs:Pipe<Variant>> <end:@R>    => Stmt::at(Pos::bytes(start as u32, end as u32), SNode::TypeDecl(h, Box::new(TypeDec::Enum(vs)))),
    <start:@L> "record" <h:TypeHeader> "{" <fs:CommaOne<TypedBinding>> "}" <end:@R> => Stmt::at(Pos::bytes(start as u32, end as u32), SNode::TypeDecl(h, Box::new(TypeDec::Record(fs))))
}

TypeHeader: TypeHeader = {
    <n:ConsName> <ts:OptTypeVars> "=" => TypeHeader { n: n, tvars: ts }
}

OptTypeVars : Vec<String> = {
                                    => vec![],
    "(" <ts:CommaOne<TypeVar>> ")"  => ts
}

TypeVar: String = {
    "'" <n:Name> => n
}

Variant: Variant = {
    <n:ConsName>                             => Variant { n: n, tparams: vec![] },
    <n:ConsName> "(" <ts:CommaOne<Type>> ")" => Variant { n: n, tparams: ts.into_iter().map(|b| *b).collect() }
}

// ----------------------------------------------------------------------------
// Statements
// ----------------------------------------------------------------------------

pub Stmt: Stmt = {
    TypeDecl    => <>,
    BlockStmt   => <>,
};

// Statements allowed inside a block. Includes a bare `Expr` so expression
// statements work (e.g. `{ print "x"; 42 }`); the block's trailing value is
// the final `Expr` in `{ BlkBody Expr }`, so a `;` before `}` is a parse
// error. The bare `Expr` alternative must NOT also appear in the top-level
// `Stmt` rule: two expression-statement contexts merged by LALR pollute the
// expression-completion states' lookahead sets and produce reduce/shift
// conflicts on every binary operator.
BlockStmt: Stmt = {
    <start:@L> "let" <n:Name> ":" <t:Type> "=" <e:Expr> <end:@R>    => Stmt::at(Pos::bytes(start as u32, end as u32), SNode::Decl(Box::new(Expr::at(Pos::bytes(start as u32, end as u32), ENode::Variable(n))), t, e)),
    <start:@L> "let" <n:Name> "=" <e:Expr> <end:@R>                 => Stmt::at(Pos::bytes(start as u32, end as u32), SNode::Decl(Box::new(Expr::at(Pos::bytes(start as u32, end as u32), ENode::Variable(n))), Box::new(Type { t : Monotype::infer() }), e)),
    <start:@L> <e:Expr> <end:@R>                                    => Stmt::at(Pos::bytes(start as u32, end as u32), SNode::Expr(e)), };

// Zero or more BlockStmt;s for the statement prefix of a block expression.
BlkBody: Vec<Stmt> = {
    => vec![],
    <mut v:BlkBody> <s:BlockStmt> ";" => { v.push(s); v },
}

// ----------------------------------------------------------------------------
// Expressions
// ----------------------------------------------------------------------------

// Precedence cascade: lowest to highest
//   LogExpr < CmpExpr < AddExpr < MulExpr < UnaryExpr < AppExpr < Atom < PostfixExpr
// `::` is right-associative (ConsExpr) and sits between the cascade and the top
// level; its left operand is a *non-binary* expression (ConsOperand), so a
// binary expression on the left requires parens: `(a + b) :: c`.
// Record literals (`Name { .. }`), `with` updates, and blocks sit at ExprBase,
// one step below the operator cascade. Field access (`.`) sits below
// application (PostfixExpr), so `f x.y` = `f (x.y)` and `(f x).y` needs parens.

pub Expr: Box<Expr> = {
    Abs_Expr                                                                => <>,
    <start:@L> "let" <n:Name> "=" <e1:Expr> "in" <e2:Expr> <end:@R>         => Box::new(Expr::at(Pos::bytes(start as u32, end as u32), ENode::Let(n, e1, e2))),
    <start:@L> "if" <c:Expr> "then" <e1:Expr> "else" <e2:Expr> <end:@R>     => Box::new(Expr::at(Pos::bytes(start as u32, end as u32), ENode::IfElse(c, e1, e2))),
    <start:@L> "match" <e:ConsExpr> "|" <cs:Pipe<MatchCase>> <end:@R>       => Box::new(Expr::at(Pos::bytes(start as u32, end as u32), ENode::Match(e, cs))),
    ConsExpr                                                                => <>,
};

MatchCase: MatchCase = {
    <v:ConsExpr> "=>" <e:ConsExpr>                                          => MatchCase{ val: v, exp: e }
};

ConsExpr: Box<Expr> = {
    ExprBase                                                                => <>,
    <start:@L> <e1:ConsOperand> "::" <e2:ConsExpr> <end:@R>                 => Box::new(Expr::at(Pos::bytes(start as u32, end as u32), ENode::Cons(e1, e2))),
};

ConsOperand: Box<Expr> = {
    UnaryExpr                                                               => <>,
    Block                                                                   => <>
};

ExprBase: Box<Expr> = {
    LogExpr                                                                 => <>,
    <start:@L> <n:ConsName> <fs:RecordBody> <end:@R>                        => Box::new(Expr::at(Pos::bytes(start as u32, end as u32), ENode::Record(Some(n), fs))),
    <start:@L> <e:WithOperand> "with" <fs:RecordBody> <end:@R>              => Box::new(Expr::at(Pos::bytes(start as u32, end as u32), ENode::With(e, fs))),
    Enum                                                                    => <>,
    Tuple                                                                   => <>,
    Block                                                                   => <>
};

// A bare constructor name (`None`) is a variable; the compiler resolves it
// against registered constructors. Constructor *application* `Some(x)` is
// handled in `PostfixExpr` so it is a valid operand of any operator.
Enum: Box<Expr> = {
    <start:@L> <n:ConsName> <end:@R>                                        => {
        let pos = Pos::bytes(start as u32, end as u32);
        Box::new(Expr::at(pos.clone(), ENode::Variable(n)))
    },
}

// A parenthesized n-tuple `(e1, e2, ...)` with at least two elements (a single
// element is just a parenthesized expression via `PostfixExpr`; `()` is the
// unit literal).
Tuple: Box<Expr> = {
    <start:@L> "(" <es:CommaTwo<Expr>> ")" <end:@R>                         =>  Box::new(Expr::at(Pos::bytes(start as u32, end as u32), ENode::Tuple(es.into_iter().map(|b| *b).collect()))),
}

WithOperand: Box<Expr> = {
    PostfixExpr                                                             => <>,
    Block                                                                   => <>
}

Block: Box<Expr> = {
    <start:@L> "{" <ss:BlkBody> <e:Expr> "}" <end:@R>                       => Box::new(Expr::at(Pos::bytes(start as u32, end as u32), ENode::Block(ss, e))),
}

RecordBody: Vec<FieldAssn> = {
    "{" <fs:CommaOne<FieldAssn>> "}" => fs
}

FieldAssn: FieldAssn = {
    <n:Name> ":" <e:Expr>                                                   => FieldAssn{ field: n, exp: e }
}

// Multi-binder sugar: `\x y z => body` desugars to `\x => \y => \z => body`.
// Explicit nested abstractions still parse (body is a full Expr).
Abs_Expr: Box<Expr> = {
    <start:@L> "\\" <mut bs:Binding+> "=>" <t:Expr> <end:@R> => {
        let mut e = t;
        while let Some(b) = bs.pop() {
            e = Box::new(Expr::at(Pos::bytes(start as u32, end as u32), ENode::Abstraction(b, e)));
        }
        e
    }
}

// --- Lowest precedence: logical (||, &&, ^) ---
LogExpr: Box<Expr> = {
    CmpExpr => <>,
    <start:@L> <e1:LogExpr> "||" <e2:CmpExpr> <end:@R> => Box::new(Expr::at(Pos::bytes(start as u32, end as u32), ENode::Logical(LogicalOp::Or, e1, e2))),
    <start:@L> <e1:LogExpr> "&&" <e2:CmpExpr> <end:@R> => Box::new(Expr::at(Pos::bytes(start as u32, end as u32), ENode::Logical(LogicalOp::And, e1, e2))),
    <start:@L> <e1:LogExpr> "^"  <e2:CmpExpr> <end:@R> => Box::new(Expr::at(Pos::bytes(start as u32, end as u32), ENode::Logical(LogicalOp::Xor, e1, e2))),
}

// --- Comparison (==, !=, <, >, <=, >=) ---
CmpExpr: Box<Expr> = {
    AddExpr => <>,
    <start:@L> <e1:AddExpr> "==" <e2:AddExpr> <end:@R> => Box::new(Expr::at(Pos::bytes(start as u32, end as u32), ENode::Comparison(CompOp::Eq, e1, e2))),
    <start:@L> <e1:AddExpr> "!=" <e2:AddExpr> <end:@R> => Box::new(Expr::at(Pos::bytes(start as u32, end as u32), ENode::Comparison(CompOp::NotEq, e1, e2))),
    <start:@L> <e1:AddExpr> "<"  <e2:AddExpr> <end:@R> => Box::new(Expr::at(Pos::bytes(start as u32, end as u32), ENode::Comparison(CompOp::Less, e1, e2))),
    <start:@L> <e1:AddExpr> ">"  <e2:AddExpr> <end:@R> => Box::new(Expr::at(Pos::bytes(start as u32, end as u32), ENode::Comparison(CompOp::Greater, e1, e2))),
    <start:@L> <e1:AddExpr> "<=" <e2:AddExpr> <end:@R> => Box::new(Expr::at(Pos::bytes(start as u32, end as u32), ENode::Comparison(CompOp::LessEq, e1, e2))),
    <start:@L> <e1:AddExpr> ">=" <e2:AddExpr> <end:@R> => Box::new(Expr::at(Pos::bytes(start as u32, end as u32), ENode::Comparison(CompOp::GreatEq, e1, e2))),
}

// --- Addition/subtraction (+, -) ---
AddExpr: Box<Expr> = {
    MulExpr => <>,
    <start:@L> <e1:AddExpr> "+" <e2:MulExpr> <end:@R> => Box::new(Expr::at(Pos::bytes(start as u32, end as u32), ENode::Arithmetic(ArithOp::Plus, e1, e2))),
    <start:@L> <e1:AddExpr> "-" <e2:MulExpr> <end:@R> => Box::new(Expr::at(Pos::bytes(start as u32, end as u32), ENode::Arithmetic(ArithOp::Minus, e1, e2))),
}

// --- Multiplication/division/modulo (*, /, %) ---
MulExpr: Box<Expr> = {
    UnaryExpr => <>,
    <start:@L> <e1:MulExpr> "*" <e2:UnaryExpr> <end:@R> => Box::new(Expr::at(Pos::bytes(start as u32, end as u32), ENode::Arithmetic(ArithOp::Times, e1, e2))),
    <start:@L> <e1:MulExpr> "/" <e2:UnaryExpr> <end:@R> => Box::new(Expr::at(Pos::bytes(start as u32, end as u32), ENode::Arithmetic(ArithOp::Div, e1, e2))),
    <start:@L> <e1:MulExpr> "%" <e2:UnaryExpr> <end:@R> => Box::new(Expr::at(Pos::bytes(start as u32, end as u32), ENode::Arithmetic(ArithOp::Mod, e1, e2))),
}

UnaryExpr: Box<Expr> = {
    AppExpr => <>,
    <start:@L> "-" <e:UnaryExpr> <end:@R> => Box::new(Expr::at(Pos::bytes(start as u32, end as u32), ENode::Unary(UnaryOp::Negate, e))),
    <start:@L> "!" <e:UnaryExpr> <end:@R> => Box::new(Expr::at(Pos::bytes(start as u32, end as u32), ENode::Unary(UnaryOp::Not, e))),
}
// --- Function application (highest binary precedence) ---
AppExpr: Box<Expr> = {
    Atom                        => <>,
    <start:@L> <t1:AppExpr> <t2:Atom> <end:@R>      => Box::new(Expr::at(Pos::bytes(start as u32, end as u32), ENode::Application(t1, t2)))
};

// --- Atoms (primary expressions) ---
Atom: Box<Expr> = {
    <start:@L> <l:Literal> <end:@R>                     => Box::new(Expr::at(Pos::bytes(start as u32, end as u32), ENode::Literal(l))),
    <start:@L> "[" "]" <end:@R>                         => Box::new(Expr::at(Pos::bytes(start as u32, end as u32), ENode::List(vec![]))),
    <start:@L> "[" <es:CommaOne<Expr>> "]" <end:@R>     => Box::new(Expr::at(Pos::bytes(start as u32, end as u32), ENode::List(es.into_iter().map(|b| *b).collect()))),
    PostfixExpr                                         => <>
};

PostfixExpr: Box<Expr> = {
    <start:@L> <n:Name> <end:@R>                        => Box::new(Expr::at(Pos::bytes(start as u32, end as u32), ENode::Variable(n))),
    // Enum constructor application: `Some(x)` / `Some(a, b)`. Desugars to a
    // left-nested application `Some a b` so the typechecker and codegen see an
    // ordinary function-applied-to-arguments.
    <start:@L> <n:ConsName> "(" <es:CommaOne<Expr>> ")" <end:@R>            => {
        let pos = Pos::bytes(start as u32, end as u32);
        let mut e = Box::new(Expr::at(pos.clone(), ENode::Variable(n)));
        for arg in es {
            e = Box::new(Expr::at(pos.clone(), ENode::Application(e, arg)));
        }
        e
    },
    <start:@L> <e:PostfixExpr> "." <n:Name> <end:@R>    => Box::new(Expr::at(Pos::bytes(start as u32, end as u32), ENode::FieldAccess(e, n))),
    "(" <e:Expr> ")"                                    => e
}

Binding: Box<Binding> = {
    Name                      => Box::new(Binding(<>, Box::new(Type { t: Monotype::infer() }))),
    "(" <b:TypedBinding> ")"  => Box::new(b),
}

TypedBinding : Binding = {
    <n:Name> ":" <t:Type> => Binding(n, t)
}

Name: String = {
    r"[a-z_][a-zA-Z0-9_]*"   => <>.to_string()
};

ConsName: String = {
    r"[A-Z][a-zA-Z0-9_]*"   => <>.to_string()
};

Literal: Box<Lit> = {
    <n:r"[0-9]+\.[0-9]+"> => Box::new(Lit::Float(f32::from_str(n).unwrap())),
    <n:r"[0-9]+">         => Box::new(Lit::Int(i32::from_str(n).unwrap())),
    "true"                  => Box::new(Lit::Bool(true)),
    "false"                 => Box::new(Lit::Bool(false)),
    // A string is lexed permissively as `"..."` where each character is either
    // an escape (`\X`, `\xHH`, or `\u{...}`) or a plain non-quote/non-backslash
    // char; the escapes are decoded by `decode_string_literal` in the action.
    <s:r#"\"(\\.|[^"\\\n\r])*\""#> => Box::new(Lit::Str(decode_string_literal(s))),
    // A char literal is lexed permissively as `'...'` (a plain char, or a
    // backslash escape: `\c`, `\xHH`, or `\u{...}`); the escape sequences are
    // decoded by `decode_char_literal` in the action.
    <c:r#"'(\\(u\{[^}]*\}|x[0-9a-fA-F]{2}|.)|[^'\\\n\r])'"#> => Box::new(Lit::Char(decode_char_literal(c))),
    "()"                    => Box::new(Lit::Unit),
}


// ----------------------------------------------------------------------------
// Util
// ----------------------------------------------------------------------------

Pipe<T>: Vec<T> = {
    <mut vec:(<T> "|")*> <e:T?> => match e {
        None => vec,
        Some(e) => {
            vec.push(e);
            vec
        }
    }
};

CommaOne<T>: Vec<T> = {
    <e:T>                         => vec![e],
    <mut v:CommaOne<T>> "," <e:T> => { v.push(e); v }
};

CommaTwo<T>: Vec<T> = {
    <mut v:CommaOne<T>> "," <e:T> => { v.push(e); v }
};

Comma<T>: Vec<T> = {
    <mut vec:(<T> ",")*> <e:T?> => match e {
        None => vec,
        Some(e) => {
            vec.push(e);
            vec
        }
    }
};

SemiCol<T>: Vec<T> = {
    <mut vec:(<T> ";")*> <e:T?> => match e {
        None => vec,
        Some(e) => {
            vec.push(e);
            vec
        }
    }
};
